FROM fedora:latest

WORKDIR /app

# Install Python, build essentials, test runners, and multi-language toolchains
RUN dnf install -y \
    python3 \
    python3-pip \
    python3-pytest \
    python3-flake8 \
    make \
    gcc \
    gcc-c++ \
    clang \
    rust \
    cargo \
    golang \
    java-latest-openjdk-devel \
    valgrind \
    procps-ng \
    && dnf clean all

COPY . /app

ENV PYTHONPATH=/app/src
CMD ["make", "test"]
