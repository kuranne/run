FROM fedora:latest

WORKDIR /app

# Install Rust toolchain, compilers, runtimes, and pytest for black-box CLI verification
RUN dnf install -y \
    rust \
    cargo \
    clippy \
    python3 \
    python3-pytest \
    make \
    gcc \
    gcc-c++ \
    clang \
    golang \
    java-latest-openjdk-devel \
    valgrind \
    procps-ng \
    && dnf clean all

COPY . /app

CMD ["make", "lint", "doc", "test"]
